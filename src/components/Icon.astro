---
/**
 * Icon Component - Supports Lucide icons and brand icons from Simple Icons
 * Usage:
 *   <Icon name="check" class="w-6 h-6" />
 *   <Icon name="netflix" type="brand" class="w-6 h-6" />
 */
import { 
  Check, 
  ChevronLeft, 
  ChevronRight, 
  Calculator, 
  Tv, 
  Wifi, 
  Home, 
  Users, 
  Zap, 
  DollarSign,
  Calendar,
  RotateCcw,
  Info,
  AlertCircle,
  CheckCircle2,
  X,
  ArrowRight,
  Menu,
  Phone,
  Mail,
  MapPin,
  Shield,
  Settings,
  Play,
  Pause,
  Monitor,
  Smartphone,
  Laptop,
  Gamepad2,
  Trophy,
  Flame,
  Film,
  Radio,
  Globe,
  Building2,
  Sparkles,
  Star,
  Clock,
  Gauge,
  Signal,
  SignalHigh,
  SignalMedium,
  SignalLow
} from '@lucide/astro';

interface Props {
  name: string;
  type?: 'lucide' | 'brand';
  class?: string;
  size?: number;
}

const { name, type = 'lucide', class: className = '', size = 24 } = Astro.props;

// Brand icons mapping (using inline SVGs from Simple Icons)
