// Lucide icons mapping
const lucideIcons: Record<string, any> = {
  check: Check,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  calculator: Calculator,
  tv: Tv,
  wifi: Wifi,
  home: Home,
  users: Users,
  zap: Zap,
  'dollar-sign': DollarSign,
  calendar: Calendar,
  'rotate-ccw': RotateCcw,
  info: Info,
  'alert-circle': AlertCircle,
  'check-circle': CheckCircle2,
  x: X,
  'arrow-right': ArrowRight,
  menu: Menu,
  phone: Phone,
  mail: Mail,
  'map-pin': MapPin,
  shield: Shield,
  settings: Settings,
  play: Play,
  pause: Pause,
  monitor: Monitor,
  smartphone: Smartphone,
  laptop: Laptop,
  gamepad: Gamepad2,
  trophy: Trophy,
  flame: Flame,
  film: Film,
  radio: Radio,
  globe: Globe,
  building: Building2,
  sparkles: Sparkles,
  star: Star,
  clock: Clock,
  gauge: Gauge,
  'signal-high': SignalHigh,
  'signal-medium': SignalMedium,
  'signal-low': SignalLow,
  signal: Signal,
};

const IconComponent = lucideIcons[name.toLowerCase()];
---

{type === 'brand' && brandIcons[name.toLowerCase()] ? (
  <span class={className} set:html={brandIcons[name.toLowerCase()]} style={`width: ${size}px; height: ${size}px; display: inline-block;`} />
) : type === 'lucide' && IconComponent ? (
  <IconComponent class={className} size={size} />
) : (
  <span class={className}>Icon not found</span>
)}