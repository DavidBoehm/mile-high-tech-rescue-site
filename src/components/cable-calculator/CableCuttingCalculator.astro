---
import Icon from '../Icon.astro';
/**
 * CableCuttingCalculator Astro Component
 * A multi-step assessment tool to estimate savings when switching to streaming.
 * Following specs from cable-calculator-docs.md
 */
---

<div id="cable-calculator-root" class="max-w-3xl mx-auto my-12 p-6 rounded-3xl bg-tech-card border border-white/10 text-white shadow-2xl">
  <!-- Progress Bar -->
  <div class="mb-8">
    <div class="flex justify-between mb-2 text-sm font-medium text-gray-400">
      <span id="step-label" class="flex items-center gap-2">
        <Icon name="calculator" class="w-4 h-4" />
        Step 1 of 5
      </span>
      <span id="step-percent">20%</span>
    </div>
    <div class="w-full bg-white/10 h-2 rounded-full overflow-hidden">
      <div id="step-progress" class="bg-gradient-to-r from-tech-accent to-tech-cyan h-full transition-all duration-300" style="width: 20%"></div>
    </div>
  </div>

  <div id="calculator-content" class="min-h-[400px]">
    <!-- Step 1: Current Provider & Bill -->
    <div id="step-1" class="step-pane space-y-6">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-tech-accent/20 text-tech-accent mb-4">
          <Icon name="tv" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl font-bold mb-2">Current Setup & Bills</h2>
        <p class="text-gray-400">Let's see what you're currently paying for TV and Internet.</p>
      </div>
      
      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="group">
            <label class="block text-sm font-medium mb-2 text-gray-300 group-focus-within:text-tech-cyan transition-colors flex items-center gap-2">
              <Icon name="building" class="w-4 h-4" />
              Current TV Provider
            </label>
            <select id="provider" class="w-full p-4 rounded-xl bg-tech-darker border border-white/10 text-white focus:border-tech-accent outline-none transition-all">
              <option value="" disabled selected>Select provider...</option>
              <option value="xfinity">Xfinity</option>
              <option value="spectrum">Spectrum</option>
              <option value="quantum">Quantum Fiber</option>
              <option value="starlink">Starlink</option>
              <option value="directv">DirecTV</option>
              <option value="dish">Dish Network</option>
              <option value="cox">Cox</option>
              <option value="other">Other / Local</option>
            </select>
          </div>
          <div class="group">
            <label class="block text-sm font-medium mb-2 text-gray-300 group-focus-within:text-tech-cyan transition-colors flex items-center gap-2">
              <Icon name="dollar-sign" class="w-4 h-4" />
              Monthly TV Bill ($)
            </label>
            <input type="number" id="tvBill" placeholder="0.00" 
                   class="w-full p-4 rounded-xl bg-white/5 border border-white/10 focus:border-tech-accent focus:ring-1 focus:ring-tech-accent outline-none transition-all text-white" />
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-white/5">
          <div class="group">
            <label class="block text-sm font-medium mb-2 text-gray-300 group-focus-within:text-tech-cyan transition-colors flex items-center gap-2">
              <Icon name="gauge" class="w-4 h-4" />
              Internet Speed
            </label>
            <select id="internetSpeed" class="w-full p-4 rounded-xl bg-tech-darker border border-white/10 text-white focus:border-tech-accent outline-none transition-all">
              <option value="" disabled selected>Select speed...</option>
              <option value="low">Below 50 Mbps</option>
              <option value="mid">50 - 200 Mbps</option>
              <option value="high">200 - 1000 Mbps (Gigabit)</option>
              <option value="ultra">1000+ Mbps</option>
            </select>
          </div>
          <div class="group">
            <label class="block text-sm font-medium mb-2 text-gray-300 group-focus-within:text-tech-cyan transition-colors flex items-center gap-2">
              <Icon name="dollar-sign" class="w-4 h-4" />
              Monthly Internet Bill ($)
            </label>
            <input type="number" id="internetBill" placeholder="0.00" 
                   class="w-full p-4 rounded-xl bg-white/5 border border-white/10 focus:border-tech-accent focus:ring-1 focus:ring-tech-accent outline-none transition-all text-white" />
          </div>
        </div>
        <p class="text-xs text-gray-500 italic flex items-center gap-2">
          <Icon name="info" class="w-4 h-4 flex-shrink-0" />
          Tip: Include box rentals, DVR fees, and premium channels in your TV bill.
        </p>
      </div>
    </div>

    <!-- Step 2: Content Preferences -->
    <div id="step-2" class="step-pane hidden space-y-6">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-tech-accent/20 text-tech-accent mb-4">
          <Icon name="film" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl font-bold mb-2">What Do You Watch?</h2>
        <p class="text-gray-400">Select the services you want to keep.</p>
      </div>
      
      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider mb-3 text-tech-cyan opacity-80 flex items-center gap-2">
            <Icon name="play" class="w-4 h-4" />
            Streaming Services
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="15.49" data-name="Netflix Standard" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Netflix Standard</span>
                <span class="text-xs text-gray-400">$15.49</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="9.99" data-name="Hulu (No Ads)" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Hulu (No Ads)</span>
                <span class="text-xs text-gray-400">$9.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="72.99" data-name="YouTube TV" checked class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">YouTube TV</span>
                <span class="text-xs text-gray-400">$72.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="6.99" data-name="Disney+" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Disney+</span>
                <span class="text-xs text-gray-400">$6.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="8.99" data-name="Max (HBO)" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Max (HBO)</span>
                <span class="text-xs text-gray-400">$8.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="5.99" data-name="Peacock" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Peacock</span>
                <span class="text-xs text-gray-400">$5.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="11.99" data-name="Paramount+" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Paramount+</span>
                <span class="text-xs text-gray-400">$11.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="streaming" value="8.99" data-name="Apple TV+" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Apple TV+</span>
                <span class="text-xs text-gray-400">$8.99</span>
              </div>
            </label>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider mb-3 text-tech-cyan opacity-80 flex items-center gap-2">
            <Icon name="trophy" class="w-4 h-4" />
            Sports Packages
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="11.99" data-name="ESPN+" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">ESPN+</span>
                <span class="text-xs text-gray-400">$11.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="14.99" data-name="NFL Sunday Ticket" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">NFL Sunday Ticket</span>
                <span class="text-xs text-gray-400">$14.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="19.99" data-name="MLB.TV" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">MLB.TV</span>
                <span class="text-xs text-gray-400">$19.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="19.99" data-name="NBA League Pass" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">NBA League Pass</span>
                <span class="text-xs text-gray-400">$19.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="9.99" data-name="DAZN" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">DAZN (Combat)</span>
                <span class="text-xs text-gray-400">$9.99</span>
              </div>
            </label>
            <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
              <input type="checkbox" name="sports" value="79.99" data-name="FuboTV Pro" class="w-4 h-4 accent-tech-accent mr-3" />
              <div class="flex-1 flex justify-between items-center">
                <span class="text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">FuboTV Pro</span>
                <span class="text-xs text-gray-400">$79.99</span>
              </div>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-white/10">
          <!-- Local News -->
          <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
            <input type="checkbox" name="content" value="local" class="w-4 h-4 accent-tech-accent mr-3" />
            <div class="flex-1 flex items-center gap-2">
              <Icon name="radio" class="w-5 h-5" />
              <div>
                <span class="block text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Local News & Weather</span>
                <span class="text-xs text-gray-400">ABC, CBS, NBC, FOX</span>
              </div>
            </div>
          </label>
          <!-- Special Interest -->
          <label class="flex items-center p-3 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all group">
            <input type="checkbox" name="content" value="specialty" class="w-4 h-4 accent-tech-accent mr-3" />
            <div class="flex-1 flex items-center gap-2">
              <Icon name="star" class="w-5 h-5" />
              <div>
                <span class="block text-sm font-medium text-white group-hover:text-tech-cyan transition-colors">Specialty Channels</span>
                <span class="text-xs text-gray-400">HGTV, Food Network, Discovery</span>
              </div>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Step 3: Home & Wi-Fi -->
    <div id="step-3" class="step-pane hidden space-y-6">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-tech-accent/20 text-tech-accent mb-4">
          <Icon name="home" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl font-bold mb-2">Home & Wi-Fi</h2>
        <p class="text-gray-400">Streaming needs a strong connection.</p>
      </div>
      
      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300 flex items-center gap-2">
              <Icon name="building" class="w-4 h-4" />
              Home Size
            </label>
            <select id="houseSize" class="w-full p-4 rounded-xl bg-tech-darker border border-white/10 text-white focus:border-tech-accent outline-none transition-all">
              <option value="" disabled selected>Select size...</option>
              <option value="small">Under 1,500 sq ft</option>
              <option value="medium">1,500 - 2,500 sq ft</option>
              <option value="large">Over 2,500 sq ft</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300 flex items-center gap-2">
              <Icon name="users" class="w-4 h-4" />
              Household Streamers
            </label>
            <div class="grid grid-cols-4 gap-2">
              <button type="button" data-value="1" class="streamer-btn p-4 rounded-xl bg-white/5 border border-white/10 border-tech-accent bg-tech-accent/10 transition-all text-center font-bold flex flex-col items-center gap-1">
                <span>1</span>
              </button>
              <button type="button" data-value="2" class="streamer-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-center font-bold flex flex-col items-center gap-1">
                <span>2</span>
              </button>
              <button type="button" data-value="3" class="streamer-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-center font-bold flex flex-col items-center gap-1">
                <span>3</span>
              </button>
              <button type="button" data-value="4" class="streamer-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-center font-bold flex flex-col items-center gap-1">
                <span>4+</span>
              </button>
            </div>
          </div>
        </div>
        <label class="flex items-center p-4 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 hover:border-tech-accent/50 transition-all group"
               for="deadZones">
          <input type="checkbox" id="deadZones" class="w-5 h-5 accent-tech-accent mr-4 pointer-events-none" />
          <div class="flex items-center gap-3 flex-1">
            <div class="w-10 h-10 rounded-lg bg-tech-accent/10 flex items-center justify-center group-hover:bg-tech-accent/20 transition-colors">
              <Icon name="signal" class="w-5 h-5 text-tech-accent" />
            </div>
            <div>
              <span class="block text-white font-medium group-hover:text-tech-cyan transition-colors">I have Wi-Fi "dead zones" in my home</span>
              <span class="text-xs text-gray-400">Areas where streaming buffers or drops</span>
            </div>
          </div>
          <div class="ml-auto">
            <div class="w-6 h-6 rounded-full border-2 border-gray-500 group-hover:border-tech-accent flex items-center justify-center transition-colors checkbox-indicator">
              <Icon name="check" class="w-4 h-4 text-white opacity-0 transition-opacity check-icon" />
            </div>
          </div>
        </label>
      </div>
    </div>

    <!-- Step 4: Habits -->
    <div id="step-4" class="step-pane hidden space-y-6">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-tech-accent/20 text-tech-accent mb-4">
          <Icon name="zap" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl font-bold mb-2">Tech Comfort</h2>
        <p class="text-gray-400">We'll tailor the setup to your experience.</p>
      </div>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-2 text-gray-300 flex items-center gap-2">
            <Icon name="settings" class="w-4 h-4" />
            How comfortable are you with new tech?
          </label>
          <div class="grid grid-cols-1 gap-2">
            <button type="button" data-level="beginner" class="tech-level-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-left flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-tech-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="monitor" class="w-5 h-5 text-tech-accent" />
              </div>
              <div>
                <strong class="block text-white">Beginner</strong>
                <span class="text-sm text-gray-400">"I'd prefer someone just set it all up for me."</span>
              </div>
            </button>
            <button type="button" data-level="intermediate" class="tech-level-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-left flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-tech-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="smartphone" class="w-5 h-5 text-tech-accent" />
              </div>
              <div>
                <strong class="block text-white">Intermediate</strong>
                <span class="text-sm text-gray-400">"I can handle some menus but might need a hand."</span>
              </div>
            </button>
            <button type="button" data-level="advanced" class="tech-level-btn p-4 rounded-xl bg-white/5 border border-white/10 hover:border-tech-accent transition-all text-left flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-tech-accent/20 flex items-center justify-center flex-shrink-0">
                <Icon name="laptop" class="w-5 h-5 text-tech-accent" />
              </div>
              <div>
                <strong class="block text-white">Advanced</strong>
                <span class="text-sm text-gray-400">"I love tech and usually figure it out myself."</span>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 5: Results -->
    <div id="step-5" class="step-pane hidden space-y-6">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-tech-accent/20 text-tech-accent mb-4">
          <Icon name="dollar-sign" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl font-bold mb-2">Your Estimated Savings</h2>
        <p class="text-gray-400">Based on your answers, here is your potential.</p>
      </div>

      <div class="bg-gradient-to-br from-tech-accent/20 to-tech-cyan/20 p-8 rounded-3xl border border-tech-accent/30 text-center">
        <div class="text-sm text-gray-300 uppercase tracking-wider mb-2 flex items-center justify-center gap-2">
          <Icon name="sparkles" class="w-4 h-4" />
          Estimated Monthly Savings
        </div>
        <div id="monthly-savings" class="text-6xl font-black text-white mb-2">$0.00</div>
        <div id="yearly-savings" class="text-xl text-tech-cyan font-semibold flex items-center justify-center gap-2">
          <Icon name="calendar" class="w-5 h-5" />
          Yearly Total: $0.00
        </div>
      </div>

      <div id="recommendations" class="space-y-3">
        <!-- Dynamic Recommendations injected here -->
      </div>

      <div class="pt-6 border-t border-white/10">
        <h3 class="text-xl font-bold mb-4 text-center flex items-center justify-center gap-2">
          <Icon name="check-circle" class="w-6 h-6 text-tech-accent" />
          Ready to start saving?
        </h3>
        <div class="grid grid-cols-1 gap-4">
          <button id="schedule-btn" class="p-5 bg-gradient-to-r from-tech-accent to-tech-cyan rounded-xl font-bold text-lg hover:scale-[1.02] transition-transform flex items-center justify-center gap-2">
            <Icon name="calendar" class="w-5 h-5" />
            Schedule Free Consultation
          </button>
          <button id="reset-btn" class="p-3 text-sm text-gray-500 hover:text-white transition-colors flex items-center justify-center gap-2">
            <Icon name="rotate-ccw" class="w-4 h-4" />
            Start Over
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <div id="nav-controls" class="mt-12 flex justify-between items-center">
    <button id="prev-btn" class="px-6 py-3 rounded-xl text-gray-400 hover:text-white transition-colors invisible flex items-center gap-2">
      <Icon name="chevron-left" class="w-4 h-4" />
      Back
    </button>
    <button id="next-btn" class="px-8 py-3 bg-white text-tech-dark font-bold rounded-xl hover:bg-tech-cyan hover:text-white transition-all flex items-center gap-2">
      Continue
      <Icon name="chevron-right" class="w-4 h-4" />
    </button>
  </div>
</div>

<script>
  const state = {
    provider: '',
    tvBill: 0,
    internetBill: 0,
    internetSpeed: '',
    content: [],
    streamingServices: [],
    sportsPackages: [],
    streamingDevices: [],
    houseSize: '',
    totalStreamers: '1',
    streamerCount: '',
    deadZones: false,
    techLevel: '',
    currentStep: 1
  };

  const stepPanes = document.querySelectorAll('.step-pane');
  const nextBtn = document.getElementById('next-btn');
  const prevBtn = document.getElementById('prev-btn');
  const stepLabel = document.getElementById('step-label');
  const stepPercent = document.getElementById('step-percent');
  const stepProgress = document.getElementById('step-progress');

  function updateUI() {
    stepPanes.forEach((pane, idx) => {
      pane.classList.toggle('hidden', idx + 1 !== state.currentStep);
    });

    const percent = (state.currentStep / 5) * 100;
    stepLabel.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="14"/><path d="M8 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M12 14h.01"/><path d="M16 18h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
      Step ${state.currentStep} of 5
    `;
    stepPercent.innerText = `${percent}%`;
    stepProgress.style.width = `${percent}%`;

    prevBtn.classList.toggle('invisible', state.currentStep === 1);
    nextBtn.classList.toggle('hidden', state.currentStep === 5);
    nextBtn.innerHTML = state.currentStep === 4 
      ? 'Calculate Savings <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>'
      : 'Continue <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>';

    if (state.currentStep === 5) {
      calculateResults();
    }
  }

  function calculateResults() {
    let streamingCost = 0;
    const recs = [];

    if (state.content.includes('sports') || state.content.includes('local')) {
      streamingCost += 72.99;
      recs.push({ title: 'YouTube TV', desc: 'Perfect for live sports and local news.', cost: '$72.99/mo' });
    } else if (state.content.includes('local')) {
      recs.push({ title: 'HD Antenna', desc: 'Free local channels after a one-time hardware cost.', cost: 'Free' });
    }

    if (state.content.includes('movies')) {
      streamingCost += 15.49;
      recs.push({ title: 'Netflix Standard', desc: 'Unlimited movies and TV series.', cost: '$15.49/mo' });
    }

    if (state.content.includes('specialty')) {
      streamingCost += 45.00;
      recs.push({ title: 'Sling TV / Hulu Live', desc: 'Access to HGTV, Food Network and more specialty cable channels.', cost: '~$45.00/mo' });
    }

    const monthlySavings = Math.max(0, state.tvBill - streamingCost);
    const yearlySavings = monthlySavings * 12;

    document.getElementById('monthly-savings').innerText = `$${monthlySavings.toFixed(2)}`;
    document.getElementById('yearly-savings').innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
      Yearly Total: $${yearlySavings.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}
    `;

    if (state.houseSize === 'large') {
      recs.push({ title: 'Mesh Wi-Fi System', desc: 'Recommended for homes over 2,500 sq ft to avoid buffering.', cost: 'Hardware Cost' });
    } else if (state.houseSize === 'medium' || state.deadZones) {
      recs.push({ title: 'Wi-Fi Extender', desc: 'Helps eliminate dead zones in medium-sized homes.', cost: 'Hardware Cost' });
    }

    // High Streamer Count + Slow Internet = Urgent Speed Upgrade
    const streamers = parseInt(state.totalStreamers) || 0;
    if ((streamers >= 3 && state.internetSpeed !== 'ultra') || (state.internetSpeed === 'low' || state.internetSpeed === 'mid')) {
      recs.push({ title: 'High-Capacity Internet', desc: 'With multiple simultaneous streams, a Gigabit connection is highly recommended to avoid buffering.', cost: 'Varies by Provider' });
    }

    if (state.techLevel === 'beginner') {
      recs.push({ title: 'White-Glove Setup', desc: 'Our professional setup ensures zero frustration.', cost: 'Consultation' });
    }

    const recContainer = document.getElementById('recommendations');
    recContainer.innerHTML = recs.map(r => `
      <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex justify-between items-center">
        <div>
          <strong class="block text-white">${r.title}</strong>
          <span class="text-sm text-gray-400">${r.desc}</span>
        </div>
        <div class="text-tech-cyan font-bold">${r.cost}</div>
      </div>
    `).join('');
  }

  nextBtn.addEventListener('click', () => {
    if (state.currentStep < 5) {
      if (state.currentStep === 1) {
        state.provider = document.getElementById('provider').value;
        state.tvBill = parseFloat(document.getElementById('tvBill').value) || 0;
        state.internetBill = parseFloat(document.getElementById('internetBill').value) || 0;
        state.internetSpeed = document.getElementById('internetSpeed').value;
      } else if (state.currentStep === 2) {
        state.content = Array.from(document.querySelectorAll('input[name="content"]:checked')).map(el => el.value);
        state.streamingServices = Array.from(document.querySelectorAll('input[name="streaming"]:checked')).map(el => ({
          name: el.dataset.name,
          price: parseFloat(el.value)
        }));
        state.sportsPackages = Array.from(document.querySelectorAll('input[name="sports"]:checked')).map(el => ({
          name: el.dataset.name,
          price: parseFloat(el.value)
        }));
      } else if (state.currentStep === 3) {
        state.houseSize = document.getElementById('houseSize').value;
        state.deadZones = document.getElementById('deadZones').checked;
      } else if (state.currentStep === 4) {
        // Tech level handled via event listener
      }

      state.currentStep++;
      updateUI();
    }
  });

  prevBtn.addEventListener('click', () => {
    if (state.currentStep > 1) {
      state.currentStep--;
      updateUI();
    }
  });

  // Visual checkbox indicator for dead zones
  const deadZonesCheckbox = document.getElementById('deadZones');
  const updateDeadZonesVisual = () => {
    const indicator = deadZonesCheckbox?.closest('label')?.querySelector('.checkbox-indicator');
    const checkIcon = indicator?.querySelector('.check-icon');
    if (deadZonesCheckbox?.checked) {
      indicator?.classList.add('bg-tech-accent', 'border-tech-accent');
      indicator?.classList.remove('border-gray-500');
      checkIcon?.classList.remove('opacity-0');
    } else {
      indicator?.classList.remove('bg-tech-accent', 'border-tech-accent');
      indicator?.classList.add('border-gray-500');
      checkIcon?.classList.add('opacity-0');
    }
  };
  deadZonesCheckbox?.addEventListener('change', updateDeadZonesVisual);

  document.querySelectorAll('.streamer-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.streamer-btn').forEach(b => b.classList.remove('border-tech-accent', 'bg-tech-accent/10'));
      btn.classList.add('border-tech-accent', 'bg-tech-accent/10');
      state.totalStreamers = btn.dataset.value;
    });
  });

  document.querySelectorAll('.tech-level-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tech-level-btn').forEach(b => b.classList.remove('border-tech-accent', 'bg-tech-accent/10'));
      btn.classList.add('border-tech-accent', 'bg-tech-accent/10');
      state.techLevel = btn.dataset.level;
    });
  });

  document.getElementById('reset-btn').addEventListener('click', () => {
    state.currentStep = 1;
    state.provider = '';
    state.tvBill = 0;
    state.internetBill = 0;
    state.internetSpeed = '';
    state.content = [];
    state.houseSize = '';
    state.totalStreamers = '';
    state.streamerCount = '';
    state.deadZones = false;
    state.techLevel = '';
    
    document.getElementById('provider').value = '';
    document.getElementById('tvBill').value = '';
    document.getElementById('internetBill').value = '';
    document.getElementById('internetSpeed').value = '';
    document.querySelectorAll('input[name="content"]').forEach(c => c.checked = false);
    document.getElementById('houseSize').value = '';
    document.querySelectorAll('.streamer-btn').forEach(b => b.classList.remove('border-tech-accent', 'bg-tech-accent/10'));
    // Reset to default 1
    const defaultBtn = document.querySelector('.streamer-btn[data-value="1"]');
    if (defaultBtn) defaultBtn.classList.add('border-tech-accent', 'bg-tech-accent/10');
    state.totalStreamers = '1';
    document.getElementById('deadZones').checked = false;
    document.querySelectorAll('.tech-level-btn').forEach(b => b.classList.remove('border-tech-accent', 'bg-tech-accent/10'));
    
    // Reset dead zones visual
    updateDeadZonesVisual();
    
    updateUI();
  });

  document.getElementById('schedule-btn').addEventListener('click', async () => {
    const btn = document.getElementById('schedule-btn');
    const originalText = btn.innerHTML;
    
    // Show loading state
    btn.innerHTML = `
      <svg class="animate-spin w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Saving...
    `;
    btn.disabled = true;
    
    try {
      // Submit to Worker
      const response = await fetch('https://savings-calculator.thedavidboehm.workers.dev/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          provider: state.provider,
          tvBill: state.tvBill,
          internetBill: state.internetBill,
          internetSpeed: state.internetSpeed,
          streamingServices: state.streamingServices,
          sportsPackages: state.sportsPackages,
          wantsLocalNews: state.content.includes('local'),
          wantsSpecialty: state.content.includes('specialty'),
          houseSize: state.houseSize,
          totalStreamers: parseInt(state.totalStreamers) || 1,
          hasDeadZones: state.deadZones,
          techLevel: state.techLevel
        })
      });
      
      const result = await response.json();
      
      if (result.success) {
        // Show success message
        btn.innerHTML = `
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          Saved!
        `;
        btn.classList.remove('from-tech-accent', 'to-tech-cyan');
        btn.classList.add('bg-green-500');
        
        // Redirect to booking after short delay
        setTimeout(() => {
          window.location.href = '/#contact';
        }, 1500);
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (error) {
      console.error('Submission error:', error);
      btn.innerHTML = `
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Error - Try Again
      `;
      btn.classList.remove('from-tech-accent', 'to-tech-cyan');
      btn.classList.add('bg-red-500');
      btn.disabled = false;
      
      // Reset after 3 seconds
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('bg-red-500');
        btn.classList.add('from-tech-accent', 'to-tech-cyan');
      }, 3000);
    }
  });

  updateUI();
</script>