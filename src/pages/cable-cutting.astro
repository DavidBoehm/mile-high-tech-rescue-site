---
// Standalone Landing Page - No shared layout
const title = "Cut Your Cable Bill in Half | Denver Cord Cutting Experts";
const description = "Save $600-$1,200/year with professional cord cutting setup. HD antenna + streaming installation in Denver. Free consultation.";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #0a0f1c;
            color: #fff;
            overflow-x: hidden;
            min-width: 320px;
        }
        
        /* Container utilities */
        .max-w-6xl { max-width: 72rem; margin-left: auto; margin-right: auto; }
        .max-w-4xl { max-width: 56rem; margin-left: auto; margin-right: auto; }
        .max-w-2xl { max-width: 42rem; margin-left: auto; margin-right: auto; }
        .mx-auto { margin-left: auto; margin-right: auto; }
        
        /* Grid utilities */
        .grid { display: grid; }
        .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .gap-4 { gap: 1rem; }
        .gap-6 { gap: 1.5rem; }
        .gap-12 { gap: 3rem; }
        
        /* Flex utilities */
        .flex { display: flex; }
        .inline-flex { display: inline-flex; }
        .flex-col { flex-direction: column; }
        .flex-wrap { flex-wrap: wrap; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .justify-center { justify-content: center; }
        .gap-2 { gap: 0.5rem; }
        .gap-4 { gap: 1rem; }
        
        /* Spacing utilities - Cleaner, more breathing room */
        .px-4 { padding-left: 1.5rem; padding-right: 1.5rem; }
        .py-2 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
        .py-24 { padding-top: 7rem; padding-bottom: 7rem; }
        .py-12 { padding-top: 4rem; padding-bottom: 4rem; }
        .p-4 { padding: 1.25rem; }
        .p-6 { padding: 2rem; }
        .p-8 { padding: 2.5rem; }
        .mb-2 { margin-bottom: 0.75rem; }
        .mb-4 { margin-bottom: 1.25rem; }
        .mb-6 { margin-bottom: 2rem; }
        .mb-8 { margin-bottom: 2.5rem; }
        .mb-12 { margin-bottom: 4rem; }
        .mb-16 { margin-bottom: 5rem; }
        .mt-1 { margin-top: 0.5rem; }
        .mt-4 { margin-top: 1.5rem; }
        .mt-6 { margin-top: 2rem; }
        .mt-8 { margin-top: 3rem; }
        
        /* Typography utilities */
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .font-bold { font-weight: 700; }
        .font-semibold { font-weight: 600; }
        .font-medium { font-weight: 500; }
        .font-mono { font-family: ui-monospace, monospace; }
        .text-sm { font-size: 0.875rem; }
        .text-base { font-size: 1rem; }
        .text-lg { font-size: 1.125rem; }
        .text-xl { font-size: 1.25rem; }
        .text-2xl { font-size: 1.5rem; }
        .text-3xl { font-size: 1.875rem; }
        .text-4xl { font-size: 2.25rem; }
        .text-5xl { font-size: 3rem; }
        .text-7xl { font-size: 4.5rem; }
        
        /* Color utilities */
        .text-white { color: #fff; }
        .text-slate-300 { color: #cbd5e1; }
        .text-slate-400 { color: #94a3b8; }
        .text-slate-500 { color: #64748b; }
        .bg-slate-800 { background-color: #1e293b; }
        .bg-slate-900 { background-color: #0f172a; }
        .bg-slate-900\\/30 { background-color: rgba(15, 23, 42, 0.3); }
        .bg-slate-900\\/50 { background-color: rgba(15, 23, 42, 0.5); }
        
        /* Display utilities */
        .block { display: block; }
        .hidden { display: none; }
        .w-full { width: 100%; }
        .h-2 { height: 0.5rem; }
        .h-5 { height: 1.25rem; }
        .h-8 { height: 2rem; }
        .w-2 { width: 0.5rem; }
        .w-5 { width: 1.25rem; }
        .w-8 { width: 2rem; }
        
        /* Border utilities */
        .rounded-full { border-radius: 9999px; }
        .rounded-xl { border-radius: 0.75rem; }
        .rounded-2xl { border-radius: 1rem; }
        .rounded-3xl { border-radius: 1.5rem; }
        
        /* Typography - Enhanced Hierarchy */
        .text-hero { 
            font-size: clamp(3rem, 8vw, 6rem); 
            font-weight: 900; 
            line-height: 1.05; 
            letter-spacing: -0.035em; 
        }
        .text-headline { 
            font-size: clamp(2rem, 5vw, 3.5rem); 
            font-weight: 800; 
            line-height: 1.1; 
            letter-spacing: -0.025em; 
        }
        .text-subhead { 
            font-size: clamp(1.25rem, 3vw, 1.75rem); 
            font-weight: 600; 
            line-height: 1.35; 
            letter-spacing: -0.01em;
        }
        .text-serif {
            font-family: 'Georgia', 'Times New Roman', serif;
            font-style: italic;
            font-weight: 400;
            letter-spacing: -0.01em;
        }
        .text-gradient {
            background: linear-gradient(135deg, #22c55e 0%, #4ade80 50%, #22c55e 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* Money styling */
        .money-green { color: #22c55e; }
        .money-glow { text-shadow: 0 0 40px rgba(34, 197, 94, 0.3); }
        
        /* Animation utilities */
        .animate-on-scroll { opacity: 0; transform: translateY(40px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .animate-on-scroll.visible { opacity: 1; transform: translateY(0); }
        .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .transition { transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 150ms; }
        .transition-all { transition-property: all; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 150ms; }
        
        /* Space utilities */
        .space-y-3 > * + * { margin-top: 0.75rem; }
        .space-y-4 > * + * { margin-top: 1rem; }
        .space-y-6 > * + * { margin-top: 1.5rem; }
        
        /* Avatar group */
        .-space-x-2 > * { margin-left: -0.5rem; }
        
        /* Border colors */
        .border-slate-600 { border-color: #475569; }
        .border-slate-700 { border-color: #334155; }
        .border-slate-800 { border-color: #1e293b; }
        .border-slate-900 { border-color: #0f172a; }
        
        /* Hero */
        .hero {
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0f1c 0%, #1a1f35 50%, #0f172a 100%);
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(circle at 20% 50%, rgba(34, 197, 94, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(6, 182, 212, 0.1) 0%, transparent 40%);
            pointer-events: none;
        }
        
        /* Money counter animation */
        .savings-counter {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: countUp 1s ease-out;
        }
        
        /* Step wizard with stagger animation */
        .step-wizard { 
            display: flex; 
            flex-direction: column; 
            gap: 2.5rem; 
        }
        .step-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.75rem;
            padding: 2.5rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .step-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .step-card:hover::before { opacity: 1; }
        .step-card:hover {
            border-color: rgba(34, 197, 94, 0.5);
            transform: translateX(10px) translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 20px rgba(34, 197, 94, 0.1);
        }
        .step-card.active {
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
            box-shadow: 0 0 30px rgba(34, 197, 94, 0.2);
        }
        /* Stagger delay for scroll animation */
        .step-card:nth-child(1) { animation-delay: 0s; }
        .step-card:nth-child(2) { animation-delay: 0.1s; }
        .step-card:nth-child(3) { animation-delay: 0.2s; }
        .step-card:nth-child(4) { animation-delay: 0.3s; }
        
        .step-number {
            width: 3rem; height: 3rem;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 1.25rem;
            margin-bottom: 1rem;
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.4);
        }
        
        /* Full-bleed sections */
        body {
            position: relative;
        }
        .section-full {
            width: 100%;
            position: relative;
        }
        .section-full > * {
            max-width: 100%;
        }
        
        /* Buttons with shine effect */
        .btn-primary {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 1rem;
            font-weight: 700;
            font-size: 1.125rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            animation: pulse-glow 2s infinite;
            position: relative;
            overflow: hidden;
        }
        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }
        .btn-primary:hover::before {
            left: 100%;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 40px rgba(34, 197, 94, 0.4);
        }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 1rem;
            font-weight: 600;
            font-size: 1.125rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }
        .btn-secondary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: left 0.5s;
        }
        .btn-secondary:hover::before {
            left: 100%;
        }
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.4);
        }
        
        /* Calculator - Amber accent for warmth */
        .calculator-container {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(251, 191, 36, 0.05));
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 2rem;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }
        .calculator-container::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(251, 191, 36, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        
        /* Secondary accent colors */
        .accent-amber { color: #fbbf24; }
        .accent-blue { color: #38bdf8; }
        .accent-purple { color: #a78bfa; }
        .bg-amber-glow { background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), transparent); }
        .bg-blue-glow { background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), transparent); }
        .bg-purple-glow { background: linear-gradient(135deg, rgba(167, 139, 250, 0.15), transparent); }
        
        /* Gradient border utility */
        .gradient-border {
            position: relative;
            background: rgba(15, 23, 42, 0.8);
            border-radius: 1.75rem;
        }
        .gradient-border::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 1.75rem;
            padding: 2px;
            background: linear-gradient(135deg, #22c55e, #fbbf24, #38bdf8, #22c55e);
            background-size: 300% 300%;
            animation: gradient-shift 8s ease infinite;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }
        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        .range-slider {
            -webkit-appearance: none;
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            outline: none;
        }
        .range-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 28px; height: 28px;
            background: #22c55e;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.5);
            transition: transform 0.2s;
        }
        .range-slider::-webkit-slider-thumb:hover { transform: scale(1.2); }
        
        /* Price cards - Glassmorphism with depth */
        .price-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.75rem;
            padding: 2.5rem;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .price-card.featured {
            border: 2px solid transparent;
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(255, 255, 255, 0.02)) padding-box,
                        linear-gradient(135deg, rgba(34, 197, 94, 0.5), rgba(6, 182, 212, 0.3)) border-box;
            transform: scale(1.05);
            box-shadow: 0 25px 50px -12px rgba(34, 197, 94, 0.25);
        }
        .price-card:hover { 
            transform: translateY(-8px); 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 30px rgba(34, 197, 94, 0.1);
            border-color: rgba(34, 197, 94, 0.3);
        }
        .price-card.featured:hover { 
            transform: scale(1.05) translateY(-8px); 
            box-shadow: 0 35px 60px -12px rgba(34, 197, 94, 0.35);
        }
        
        /* Glassmorphism container */
        .glass-container {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 2rem;
            padding: 3rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        
        /* Sticky nav */
        .sticky-nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            background: rgba(10, 15, 28, 0.9);
            backdrop-filter: blur(20px);
            z-index: 1000;
            padding: 1rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transform: translateY(-100%);
            transition: transform 0.3s;
        }
        .sticky-nav.visible { transform: translateY(0); }
        
        /* Form */
        .form-input {
            width: 100%;
            padding: 1rem 1.25rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 0.75rem;
            color: white;
            font-size: 1rem;
            transition: all 0.3s;
        }
        .form-input:focus {
            outline: none;
            border-color: #22c55e;
            background: rgba(255, 255, 255, 0.08);
        }
        .form-input::placeholder { color: rgba(255, 255, 255, 0.4); }
        
        /* Responsive - Mobile First */
        @media (max-width: 1024px) {
            .lg\\:grid-cols-2 { grid-template-columns: 1fr; }
            .lg\\:sticky { position: relative; top: 0; }
        }
        
        @media (max-width: 768px) {
            .md\\:grid-cols-3 { grid-template-columns: 1fr; }
            .md\\:grid-cols-2 { grid-template-columns: 1fr; }
            .text-hero { font-size: clamp(2rem, 10vw, 3rem); line-height: 1.1; }
            .text-headline { font-size: clamp(1.5rem, 8vw, 2rem); letter-spacing: -0.02em; }
            .text-5xl { font-size: 2rem; }
            .text-7xl { font-size: 2.5rem; }
            .step-card:hover { transform: none; }
            .step-card.active:hover { transform: none; }
            .price-card.featured { transform: scale(1); margin: 1rem 0; }
            .price-card.featured:hover { transform: scale(1); }
            .py-24 { padding-top: 3rem; padding-bottom: 3rem; }
            .p-8 { padding: 1.5rem; }
            .calculator-container { padding: 1.5rem; }
            .sticky-nav { padding: 0.75rem 1rem; }
        }
        
        @media (min-width: 640px) {
            .sm\\:px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
        }
        
        @media (min-width: 768px) {
            .md\\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .md\\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .lg\\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        
        @media (min-width: 1024px) {
            .lg\\:top-24 { top: 6rem; }
            .lg\\:sticky { position: sticky; }
            .lg\\:px-8 { padding-left: 2rem; padding-right: 2rem; }
        }
        
        /* Form select fix */
        select.form-input option {
            background-color: #0f172a;
            color: #fff;
        }
        
        /* Smooth scrolling offset for sticky nav */
        html {
            scroll-padding-top: 80px;
        }
    </style>
</head>
<body>
    <!-- Sticky Nav -->
    <nav class="sticky-nav" id="stickyNav">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="font-bold text-xl money-green">💰 Denver Cord Cutting</div>
            <a href="#book" class="btn-primary text-sm py-2 px-4">Book Free Consult</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero section-full">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="animate-on-scroll">
                    <div class="inline-flex items-center gap-2 bg-green-500/10 border border-green-500/30 rounded-full px-4 py-2 mb-6">
                        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                        <span class="text-green-400 text-sm font-semibold">Denver's #1 Cord Cutting Service</span>
                    </div>
                    
                    <h1 class="text-hero mb-6">
                        Cut Your Cable Bill<br>
                        <span class="text-gradient money-glow">in Half</span>
                    </h1>
                    
                    <p class="text-xl text-slate-400 mb-8 max-w-xl">
                        Professional antenna installation + streaming setup. 
                        <span class="text-white font-semibold">Keep every channel you watch</span> while saving 
                        <span class="money-green font-bold">$600-$1,200/year</span>.
                    </p>
                    
                    <div class="flex flex-wrap gap-4 mb-12">
                        <a href="#book" class="btn-primary">
                            Get Free Consultation
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                        <a href="#calculator" class="btn-secondary">Calculate My Savings</a>
                    </div>
                    
                    <!-- Social Proof -->
                    <div class="flex items-center gap-6 text-sm text-slate-400">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full border-2 border-slate-900"></div>
                            <div class="w-8 h-8 bg-gradient-to-br from-purple-400 to-purple-600 rounded-full border-2 border-slate-900"></div>
                            <div class="w-8 h-8 bg-gradient-to-br from-pink-400 to-pink-600 rounded-full border-2 border-slate-900"></div>
                        </div>
                        <span><span class="text-white font-semibold">500+</span> Denver families saved money</span>
                        <span class="text-amber-400">★★★★★</span>
                    </div>
                </div>
                
                <!-- Savings Card -->
                <div class="animate-on-scroll" style="animation-delay: 0.2s;">
                    <div class="bg-slate-900/50 backdrop-blur border border-slate-700 rounded-3xl p-8 relative">
                        <div class="absolute -top-4 -right-4 bg-green-500 text-slate-900 font-bold px-4 py-2 rounded-full text-sm">
            Average Savings
          </div>
                        
                        <div class="text-center mb-8">
                            <div class="text-slate-400 text-sm mb-2">Yearly Savings</div>
                            <div class="savings-counter text-7xl font-black" id="heroSavings">$1,200</div>
                        </div>
                        
                        <div class="space-y-4">
                            <div class="flex justify-between items-center p-4 bg-red-500/10 rounded-xl border border-red-500/20">
                                <span class="text-slate-400">Cable Bill</span>
                                <span class="text-red-400 font-bold text-xl">$2,160/yr</span>
                            </div>
