    <!-- Scripts -->
    <script is:inline>
        // Sticky nav
        const stickyNav = document.getElementById('stickyNav');
        window.addEventListener('scroll', () => {
            stickyNav.classList.toggle('visible', window.scrollY > 500);
        });

        // Scroll animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));

        // Step wizard
        document.querySelectorAll('.step-card').forEach(card => {
            card.addEventListener('click', () => {
                document.querySelectorAll('.step-card').forEach(c => {
                    c.classList.remove('active');
                    c.querySelector('.step-detail').classList.add('hidden');
                });
                card.classList.add('active');
                card.querySelector('.step-detail').classList.remove('hidden');
            });
        });

        // Calculator with smooth number animation
        const billSlider = document.getElementById('billSlider');
        const billDisplay = document.getElementById('billDisplay');
        const currentYearly = document.getElementById('currentYearly');
        const newYearly = document.getElementById('newYearly');
        const totalSavings = document.getElementById('totalSavings');
        const ctaSavings = document.getElementById('ctaSavings');

        function animateNumber(element, start, end, duration = 300) {
            const startTime = performance.now();
            const startVal = parseInt(start.toString().replace(/[^0-9]/g, '')) || 0;
            const endVal = parseInt(end.toString().replace(/[^0-9]/g, '')) || 0;
            
            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeProgress = 1 - Math.pow(1 - progress, 3); // easeOutCubic
                const current = Math.round(startVal + (endVal - startVal) * easeProgress);
                
                if (element.id === 'billDisplay') {
                    element.textContent = `$${current}/mo`;
                } else {
                    element.textContent = `$${current.toLocaleString()}`;
                }
                
                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }
            
            requestAnimationFrame(update);
        }

        let lastValues = { monthly: 180, yearly: 2160, savings: 1320 };

        function updateCalculator() {
            const monthly = parseInt(billSlider.value);
            const yearly = monthly * 12;
            const newYearlyCost = 600 + 249;
            const savings = yearly - newYearlyCost;

            // Animate the numbers
            animateNumber(billDisplay, lastValues.monthly, monthly);
            animateNumber(currentYearly, lastValues.yearly, yearly);
            animateNumber(totalSavings, lastValues.savings, savings);
            
            // Direct update for CTA (no animation needed)
            ctaSavings.textContent = savings.toLocaleString();
            
            // Store current values for next animation
            lastValues = { monthly, yearly, savings };
        }

        billSlider.addEventListener('input', updateCalculator);
        updateCalculator();

        // Form submission - Using working pattern from book.astro
        document.getElementById('bookingForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            const btn = e.target.querySelector('button[type="submit"]');
            const statusDiv = document.getElementById('formMessage');
            
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.innerHTML = '<span class="animate-spin">⟳</span> Sending...';
            statusDiv.classList.remove('hidden');
            
            try {
                const response = await fetch('https://api.milehightechrescue.com/booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                if (response.ok) {
                    statusDiv.className = 'block p-4 rounded-lg bg-green-500/20 border border-green-500/50 text-green-400 text-center mt-4';
                    statusDiv.innerHTML = '<strong>✓ Request Received!</strong><br>We will contact you within 24 hours.';
                    e.target.reset();
                } else {
                    throw new Error('API error');
                }
            } catch (err) {
                statusDiv.className = 'block p-4 rounded-lg bg-yellow-500/20 border border-yellow-500/50 text-yellow-400 text-center mt-4';
                statusDiv.innerHTML = '<strong>⚠️ Request Saved</strong><br>We will contact you soon.';
            }
            
            btn.disabled = false;
            btn.textContent = originalText;
        });
    </script>
