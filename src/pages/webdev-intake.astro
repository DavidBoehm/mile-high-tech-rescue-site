---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Web Development Project Intake">
  <main class="min-h-screen bg-slate-950">
    <!-- Hero -->
    <section class="relative pt-32 pb-16 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800">
      <div class="absolute inset-0 opacity-20">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500/20 via-transparent to-transparent"></div>
      </div>
      <div class="container mx-auto px-4 relative">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
            Website Project <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Intake</span>
          </h1>
          <p class="text-lg text-slate-400">
            Tell us about your project so we can build exactly what you need
          </p>
        </div>
      </div>
    </section>

    <!-- Form Section -->
    <section class="py-16 bg-slate-950">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto">
          <form id="intakeForm" class="bg-slate-900 border border-slate-700 rounded-2xl p-8 space-y-8">
            
            <!-- Business Identity -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Business Information</h2>
              
              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Business Name *</label>
                <input type="text" name="business_name" required 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="Acme Corp">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Tagline or Slogan</label>
                <input type="text" name="tagline" 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="Making the impossible possible">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Brief Description *</label>
                <textarea name="description" rows="3" required 
                          class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                          placeholder="What does your business do?"></textarea>
              </div>
            </div>

            <!-- Pages Needed -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Pages Needed</h2>
              <p class="text-slate-400 text-sm">Select all that apply</p>
              
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="home" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">Home</span>
                </label>
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="about" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">About</span>
                </label>
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="services" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">Services</span>
                </label>
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="portfolio" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">Portfolio/Gallery</span>
                </label>
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="contact" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">Contact</span>
                </label>
                <label class="flex items-center space-x-3 bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 cursor-pointer hover:border-cyan-500/50 transition-colors">
                  <input type="checkbox" name="pages" value="blog" class="w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <span class="text-slate-300">Blog</span>
                </label>
              </div>
              
              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Other Pages</label>
                <input type="text" name="other_pages" 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="e.g., Testimonials, FAQ, Team">
              </div>
            </div>

            <!-- Assets -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Logo & Assets</h2>
              
              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Logo</label>
                <div class="border-2 border-dashed border-slate-600 rounded-lg p-6 text-center hover:border-cyan-500/50 transition-colors">
                  <input type="file" id="logoUpload" name="logo" accept="image/*" class="hidden">
                  <label for="logoUpload" class="cursor-pointer">
                    <svg class="w-12 h-12 text-slate-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <p class="text-slate-400 mb-2">Click to upload logo</p>
                    <p class="text-slate-500 text-sm" id="logoFileName">PNG, JPG, SVG up to 5MB</p>
                  </label>
                  <div id="logoUploadStatus" class="hidden mt-3">
                    <span class="text-cyan-400 text-sm">Uploading...</span>
                  </div>
                  <input type="hidden" name="logo_url" id="logoUrl">
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Photos & Images</label>
                <div class="border-2 border-dashed border-slate-600 rounded-lg p-6 text-center hover:border-cyan-500/50 transition-colors">
                  <input type="file" id="photosUpload" name="photos" accept="image/*" multiple class="hidden">
                  <label for="photosUpload" class="cursor-pointer">
                    <svg class="w-12 h-12 text-slate-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <p class="text-slate-400 mb-2">Click to upload photos</p>
                    <p class="text-slate-500 text-sm" id="photosFileName">PNG, JPG up to 5MB each</p>
                  </label>
                  <div id="photosUploadStatus" class="hidden mt-3">
                    <span class="text-cyan-400 text-sm">Uploading...</span>
                  </div>
                  <input type="hidden" name="photos_urls" id="photosUrls">
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Social Media & Review Sites</label>
                <p class="text-slate-400 text-sm mb-3">Links to your existing profiles</p>
                
                <div class="space-y-3">
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/>
                    </svg>
                    <input type="url" name="facebook_url" placeholder="Facebook" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                    </svg>
                    <input type="url" name="discord_url" placeholder="Discord" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    <input type="url" name="yelp_url" placeholder="Yelp" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2c.183 0 .365.006.545.017C14.59 4.002 16.5 6.838 16.5 10c0 1.933-.67 3.71-1.79 5.12 1.12-.38 2.15-1.03 3.02-1.9.28-.28.54-.58.78-.9.06 1.02.09 2.05.09 3.08 0 1.2-.05 2.38-.15 3.54-1.32.42-2.72.63-4.16.63-1.44 0-2.84-.21-4.16-.63-.1-1.16-.15-2.34-.15-3.54 0-1.03.03-2.06.09-3.08.24.32.5.62.78.9.87.87 1.9 1.52 3.02 1.9-1.12-1.41-1.79-3.19-1.79-5.12 0-3.162 1.91-5.998 3.955-9.983C11.635 2.006 11.817 2 12 2z"/>
                    </svg>
                    <input type="url" name="nextdoor_url" placeholder="Nextdoor" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.263-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                    </svg>
                    <input type="url" name="youtube_url" placeholder="YouTube" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <input type="url" name="instagram_url" placeholder="Instagram" 
                           class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Tone / Style</label>
                <select name="tone" 
                        class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors">
                  <option value="">Select style...</option>
                  <option value="modern">Modern & Clean</option>
                  <option value="professional">Professional & Corporate</option>
                  <option value="playful">Playful & Fun</option>
                  <option value="minimalist">Minimalist</option>
                  <option value="bold">Bold & Eye-catching</option>
                  <option value="other">Other (describe in comments)</option>
                </select>
              </div>
            </div>

            <!-- Features -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Features & Integrations</h2>
              <p class="text-slate-400 text-sm">Select all that apply</p>
              
              <div class="space-y-3">
                <label class="flex items-start space-x-3 cursor-pointer">
                  <input type="checkbox" name="features" value="contact_form" class="mt-1 w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <div>
                    <span class="text-slate-300 font-medium">Contact Form</span>
                    <p class="text-slate-500 text-sm">Let visitors send you messages</p>
                  </div>
                </label>
                <label class="flex items-start space-x-3 cursor-pointer">
                  <input type="checkbox" name="features" value="booking" class="mt-1 w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <div>
                    <span class="text-slate-300 font-medium">Booking / Appointment System</span>
                    <p class="text-slate-500 text-sm">Let clients schedule directly</p>
                  </div>
                </label>
                <label class="flex items-start space-x-3 cursor-pointer">
                  <input type="checkbox" name="features" value="social" class="mt-1 w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <div>
                    <span class="text-slate-300 font-medium">Social Media Links</span>
                    <p class="text-slate-500 text-sm">Link to your social profiles</p>
                  </div>
                </label>
                <label class="flex items-start space-x-3 cursor-pointer">
                  <input type="checkbox" name="features" value="newsletter" class="mt-1 w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <div>
                    <span class="text-slate-300 font-medium">Newsletter Signup</span>
                    <p class="text-slate-500 text-sm">Collect email subscribers</p>
                  </div>
                </label>
                <label class="flex items-start space-x-3 cursor-pointer">
                  <input type="checkbox" name="features" value="analytics" class="mt-1 w-4 h-4 text-cyan-500 rounded border-slate-600 bg-slate-700 focus:ring-cyan-500">
                  <div>
                    <span class="text-slate-300 font-medium">Google Analytics</span>
                    <p class="text-slate-500 text-sm">Track visitor stats</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Domain -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Domain & Email</h2>
              
              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Desired Domain Name</label>
                <input type="text" name="domain" 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="www.yourbusiness.com">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Email Addresses Needed</label>
                <input type="text" name="emails" 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="e.g., info@, support@, hello@">
              </div>
            </div>

            <!-- Contact Info -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Your Contact Information</h2>
              
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-2">Your Name *</label>
                  <input type="text" name="contact_name" required 
                         class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                         placeholder="Jane Smith">
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-2">Your Email *</label>
                  <input type="email" name="contact_email" required 
                         class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                         placeholder="jane@example.com">
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Phone</label>
                <input type="tel" name="contact_phone" 
                       class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                       placeholder="(303) 555-0123">
              </div>
            </div>

            <!-- Additional Comments -->
            <div class="space-y-6">
              <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Additional Comments</h2>
              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Anything else we should know?</label>
                <textarea name="comments" rows="4" 
                          class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-3 text-white focus:border-cyan-500 focus:outline-none transition-colors"
                          placeholder="Special requirements, deadlines, or anything else..."></textarea>
              </div>
            </div>

            <!-- Submit -->
            <div class="pt-6 border-t border-slate-700">
              <button type="submit" id="submitBtn" class="w-full bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white font-bold py-4 rounded-lg transition-all">
                Submit Project Details
              </button>
              <div id="formStatus" class="hidden mt-4 p-4 rounded-lg"></div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    const UPLOAD_URL = 'https://milehigh-intake-upload.ksavage5280.workers.dev/';
    const EMAIL_URL = 'https://milehigh-form-email.ksavage5280.workers.dev/';

    // Handle logo file upload
    const logoInput = document.getElementById('logoUpload');
    const logoFileName = document.getElementById('logoFileName');
    const logoUploadStatus = document.getElementById('logoUploadStatus');
    const logoUrlInput = document.getElementById('logoUrl');

    logoInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      logoFileName.textContent = file.name;
      logoUploadStatus.classList.remove('hidden');
      logoUploadStatus.innerHTML = '<span class="text-cyan-400 text-sm">Uploading...</span>';

      try {
        const formData = new FormData();
        formData.append('file', file);

        const response = await fetch(UPLOAD_URL, {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          logoUrlInput.value = result.url;
          logoUploadStatus.innerHTML = '<span class="text-green-400 text-sm">✓ Uploaded successfully</span>';
        } else {
          throw new Error(result.error || 'Upload failed');
        }
      } catch (err) {
        logoUploadStatus.innerHTML = '<span class="text-red-400 text-sm">✗ Upload failed. Please try again.</span>';
        console.error('Upload error:', err);
      }
    });

    // Handle photos upload
    const photosInput = document.getElementById('photosUpload');
    const photosFileName = document.getElementById('photosFileName');
    const photosUploadStatus = document.getElementById('photosUploadStatus');
    const photosUrlsInput = document.getElementById('photosUrls');

    photosInput.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files);
      if (files.length === 0) return;

      photosFileName.textContent = `${files.length} file(s) selected`;
      photosUploadStatus.classList.remove('hidden');
      photosUploadStatus.innerHTML = '<span class="text-cyan-400 text-sm">Uploading...</span>';

      const uploadedUrls = [];
      
      try {
        for (const file of files) {
          const formData = new FormData();
          formData.append('file', file);

          const response = await fetch(UPLOAD_URL, {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (result.success) {
            uploadedUrls.push(result.url);
          } else {
            throw new Error(result.error || 'Upload failed');
          }
        }
        
        photosUrlsInput.value = uploadedUrls.join(',');
        photosUploadStatus.innerHTML = '<span class="text-green-400 text-sm">✓ Uploaded successfully</span>';
      } catch (err) {
        photosUploadStatus.innerHTML = '<span class="text-red-400 text-sm">✗ Upload failed. Please try again.</span>';
        console.error('Upload error:', err);
      }
    });

    // Handle form submission
    const form = document.getElementById('intakeForm');
    const submitBtn = document.getElementById('submitBtn');
    const formStatus = document.getElementById('formStatus');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="animate-spin">⟳</span> Submitting...';
      formStatus.classList.add('hidden');

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      // Get checkbox values properly
      data.pages = Array.from(form.querySelectorAll('input[name="pages"]:checked')).map(cb => cb.value);
      data.features = Array.from(form.querySelectorAll('input[name="features"]:checked')).map(cb => cb.value);

      // Send via Worker
      const emailResponse = await fetch(EMAIL_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (emailResponse.ok) {
        formStatus.className = 'block p-4 rounded-lg bg-green-500/20 border border-green-500/50 text-green-400';
        formStatus.innerHTML = '<strong>✅ Form Submitted!</strong><br>We received your project details and will be in touch soon.';
        form.reset();
        logoFileName.textContent = 'PNG, JPG, SVG up to 5MB';
        logoUploadStatus.classList.add('hidden');
        photosFileName.textContent = 'PNG, JPG up to 5MB each';
        photosUploadStatus.classList.add('hidden');
        submitBtn.textContent = 'Form Submitted!';
      } else {
        throw new Error('Email failed');
      }
      formStatus.classList.remove('hidden');
      
      submitBtn.disabled = false;
      if (!formStatus.innerHTML.includes('Form Submitted')) {
        submitBtn.textContent = 'Submit Project Details';
      }
    });
  </script>
</Layout>
