---
// Minimal Layout - No Navbar, No Footer
// For standalone pages like the savings calculator

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Professional IoT, Smart Home & IT Solutions in Denver | Mile High Tech Rescue",
  image = "/og-image.jpg"
} = Astro.props;

const canonicalUrl = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <!-- Google AdSense Verification -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9999690081619988"
       crossorigin="anonymous"></script>
  
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-J3RXFKTJ7K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-J3RXFKTJ7K');
  </script>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={`https://milehightechrescue.com${canonicalUrl}`} />
  
  <!-- Title -->
  <title>{title} | Mile High Tech Rescue</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Brand Icons CDN (Simple Icons) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-icons-font/font/simple-icons.min.css">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://milehightechrescue.com${canonicalUrl}`} />
  <meta property="og:title" content={`${title} | Mile High Tech Rescue`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://milehightechrescue.com${image}`} />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={`https://milehightechrescue.com${canonicalUrl}`} />
  <meta property="twitter:title" content={`${title} | Mile High Tech Rescue`} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={`https://milehightechrescue.com${image}`} />
</head>
<body class="bg-tech-dark text-white antialiased min-h-screen">
  <!-- Only the slot content - no nav, no footer -->
  <slot />
</body>
</html>
